            },
            {
              "id": "triageConfidence",
              "label": "Triage confidence",
              "type": "number",
              "direction": "input",
              "binding": "vars.triageAgent.output.confidence"
            },
            {
              "id": "evidenceSummary",
              "label": "Specialist evidence",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.evidenceSummary"
            },
            {
              "id": "rootCause",
              "label": "Root cause",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.rootCause"
            },
            {
              "id": "recommendedAction",
              "label": "Recommended action",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.recommendedAction"
            },
            {
              "id": "actionCode",
              "label": "Action code",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.actionCode"
            },
            {
              "id": "adjustmentAmount",
              "label": "Adjustment amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.adjustmentAmount"
            },
            {
              "id": "specialistConfidence",
              "label": "Specialist confidence",
              "type": "number",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.confidence"
            },
            {
              "id": "emailSubject",
              "label": "Email subject preview",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.emailSubject"
            },
            {
              "id": "emailBody",
              "label": "Email body preview",
              "type": "string",
              "direction": "input",
              "binding": "vars.normalizeProposal.output.emailBody"
            },
            {
              "id": "approvedBy",
              "label": "Approved by",
              "type": "string",
              "direction": "output",
              "variable": "vars.approvedBy",
              "required": true
            },
            {
              "id": "approvalComments",
              "label": "Approval comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.approvalCommentsInput",
              "required": true
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "action": "Continue",
              "isPrimary": true
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "action": "End",
              "isPrimary": false
            }
          ]
        },
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "descriptionKey": "hitlOutputBuilder_taskResultData_description",
          "source": "=result",
          "var": "output",
          "properties": {
            "approvedBy": {
              "type": "string",
              "title": "Approved by"
            },
            "approvalCommentsInput": {
              "type": "string",
              "title": "Approval comments",
              "fieldId": "approvalComments"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "descriptionKey": "hitlOutputBuilder_taskCompletionStatus_description",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "isResolutionApproved",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution approved?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "=js:$vars.quickForm1.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Needs rework"
      }
    }
