{
  "id": "2af1fdaa-b414-460f-9f42-b099f793059c",
  "version": "1.9",
  "name": "ARCollectionsDisputeResolution",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Start AR dispute",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "13a89eab-d48e-4b3e-9cf4-e902f60985bc",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "loadSampleCase",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Load Sample Case",
        "icon": "code"
      },
      "inputs": {
        "script": "const cases = {\n  \"AR-PO-001\": {\n    caseId: \"AR-PO-001\",\n    customerName: \"Northstar Manufacturing\",\n    customerAccountId: \"NORTHSTAR-1701\",\n    invoiceNumber: \"INV-10471\",\n    outstandingBalance: 48750,\n    customerReason: \"The invoice exceeds our purchase order and requires correction.\",\n    openedDate: \"2026-07-07\",\n    evidence: { purchaseOrderNumber: \"PO-77124\", invoiceAmount: 48750, poAuthorizedAmount: 47250, difference: 1500 }\n  },\n  \"AR-POD-002\": {\n    caseId: \"AR-POD-002\",\n    customerName: \"Riverbend Retail\",\n    customerAccountId: \"RIVERBEND-2904\",\n    invoiceNumber: \"INV-20482\",\n    outstandingBalance: 22400,\n    customerReason: \"Payment is on hold pending proof of delivery.\",\n    openedDate: \"2026-07-10\",\n    evidence: { deliveredDate: \"2026-06-18\", signer: \"M. Chen\", shipmentQuantity: 80, invoiceQuantity: 80, quantitiesMatch: true }\n  },\n  \"AR-PAY-003\": {\n    caseId: \"AR-PAY-003\",\n    customerName: \"Summit Medical Distribution\",\n    customerAccountId: \"SUMMIT-4402\",\n    invoiceNumber: \"INV-30915\",\n    outstandingBalance: 36800,\n    customerReason: \"We paid this invoice, but the balance is still open.\",\n    openedDate: \"2026-07-14\",\n    evidence: { reportedPaymentAmount: 36800, paymentReference: \"PAY-77821\" }\n  },\n  \"AR-AMB-004\": {\n    caseId: \"AR-AMB-004\",\n    customerName: \"Lakeshore Components\",\n    customerAccountId: \"LAKESHORE-5506\",\n    invoiceNumber: \"INV-40102\",\n    outstandingBalance: 12800,\n    customerReason: \"The balance does not look right; please investigate\",\n    openedDate: \"2026-07-18\",\n    evidence: {}\n  }\n};\nconst caseId = $vars.start.output.caseId;\nif (!Object.prototype.hasOwnProperty.call(cases, caseId)) {\n  throw new Error(\"Unsupported sample caseId: \" + caseId);\n}\nreturn { ...cases[caseId], evidence: JSON.stringify(cases[caseId].evidence) };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "triageAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Grounded Dispute Triage",
        "subLabel": "",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "source": "f7d7d1a5-0f16-43f1-b1b8-b70cef70ece9",
        "agentInputVariables": [
          {
            "id": "loadSampleCase__output__output",
            "type": "object",
            "binding": "=$vars.loadSampleCase.output",
            "description": "Case packet returned by Load Sample Case"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "disputeType",
            "type": "string"
          },
          {
            "id": "rationale",
            "type": "string"
          },
          {
            "id": "confidence",
            "type": "number"
          }
        ]
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isSupportedTriage",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Supported and confident?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "=js:$vars.triageAgent.output.confidence >= 0.75 && [\"po_mismatch\", \"missing_pod\", \"payment_misapplication\"].indexOf($vars.triageAgent.output.disputeType) >= 0",
        "trueLabel": "Supported",
        "falseLabel": "Manual triage"
      }
    },
    {
      "id": "routeByDisputeType",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Dispute Type",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "po-mismatch",
            "label": "PO mismatch",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"po_mismatch\""
          },
          {
            "id": "missing-pod",
            "label": "Missing POD",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"missing_pod\""
          },
          {
            "id": "payment-misapplication",
            "label": "Payment misapplication",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"payment_misapplication\""
          }
        ]
      }
    },
