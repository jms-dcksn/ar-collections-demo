    {
      "id": "sendEmail1",
      "type": "uipath.connector.uipath-microsoft-outlook365.send-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send Email",
        "subLabel": "",
        "icon": "https://cloud.uipath.com/a17c9af1-091d-4dd2-9cec-ed787c6601c8/studio_/typecache/icons/160499b52f7cea190b530fe6f40da7ee03455a8d3fb72dd7f4f68d61e7865a3a.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
