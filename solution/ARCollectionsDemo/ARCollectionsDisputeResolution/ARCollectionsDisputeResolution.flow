      },
      "inputs": {
        "type": "quick",
        "title": "Review AR dispute resolution",
        "priority": "Medium",
        "schema": {
          "id": "6593dd8f-75d0-4df3-8eff-8b4940a536f3",
          "title": "Review AR dispute resolution",
          "fields": [
            {
              "id": "customerName",
              "type": "string",
              "label": "Customer",
              "direction": "input",
              "binding": "vars.loadSampleCase.output.customerName"
            },
            {
              "id": "invoiceNumber",
              "label": "Invoice",
