    {
      "id": "normalizeProposal",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Proposal",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "const candidates = [\n    $vars.poMismatchAgent.output,\n    $vars.missingPodAgent.output,\n    $vars.paymentMisapplicationAgent.output\n  ].filter(function (candidate) { return candidate && candidate.caseId; });\n  if (candidates.length !== 1) {\n    throw new Error(\"Expected exactly one specialist proposal; received \" +\n  candidates.length);\n  }\n  const proposal = candidates[0];\n  const required = [\n    \"caseId\", \"disputeType\", \"evidenceSummary\", \"rootCause\",\n    \"recommendedAction\", \"actionCode\", \"adjustmentAmount\", \"confidence\",\n    \"approvalSummary\", \"emailSubject\", \"emailBody\", \"resourcesUsed\"\n  ];\n  const missing = required.filter(function (field) {\n    return proposal[field] === null || proposal[field] === undefined;\n  });\n  if (missing.length !== 0) {\n    throw new Error(\n      \"Missing specialist proposal fields: \" + missing.join(\", \") +\n      \" (received: \" + Object.keys(proposal).sort().join(\", \") + \")\"\n    );\n  }\n  if (typeof proposal.adjustmentAmount !== \"number\" || typeof proposal.confidence\n  !== \"number\") {\n    throw new Error(\"Specialist numeric fields have invalid types\");\n  }\n  const normalized = {};\n  required.forEach(function (field) { normalized[field] = proposal[field]; });\n  return normalized;",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
