    {
      "id": "normalizeProposal",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Proposal",
        "icon": "code"
      },
      "inputs": {
        "script": "const candidates = [\n  $vars.poMismatchAgent.output,\n  $vars.missingPodAgent.output,\n  $vars.paymentMisapplicationAgent.output\n].filter(function (candidate) { return candidate && candidate.caseId; });\nif (candidates.length !== 1) {\n  throw new Error(\"Expected exactly one specialist proposal; received \" + candidates.length);\n}\nconst proposal = candidates[0];\nconst required = [\n  \"caseId\", \"disputeType\", \"evidenceSummary\", \"rootCause\",\n  \"recommendedAction\", \"actionCode\", \"adjustmentAmount\", \"confidence\",\n  \"approvalSummary\", \"emailSubject\", \"emailBody\", \"resourcesUsed\"\n];\nconst actual = Object.keys(proposal).sort();\nconst expected = required.slice().sort();\nif (JSON.stringify(actual) !== JSON.stringify(expected)) {\n  throw new Error(\"Specialist proposal must contain exactly the 12-field contract\");\n}\nrequired.forEach(function (field) {\n  if (proposal[field] === null || proposal[field] === undefined) {\n    throw new Error(\"Missing specialist proposal field: \" + field);\n  }\n});\nif (typeof proposal.adjustmentAmount !== \"number\" || typeof proposal.confidence !== \"number\") {\n  throw new Error(\"Specialist numeric fields have invalid types\");\n}\nreturn proposal;"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
