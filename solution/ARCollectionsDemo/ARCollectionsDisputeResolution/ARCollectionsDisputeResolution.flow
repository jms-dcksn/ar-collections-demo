    {
      "id": "sendEmail1",
      "type": "uipath.connector.uipath-microsoft-outlook365.send-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send Email",
        "subLabel": "",
        "icon": "https://staging.uipath.com/95baf7a2-59c4-4438-93bb-55967f104904/studio_/typecache/icons/160499b52f7cea190b530fe6f40da7ee03455a8d3fb72dd7f4f68d61e7865a3a.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "8643408a-62b4-4d36-ba1e-bc9b68d4fce9",
          "connectionResourceId": "8643408a-62b4-4d36-ba1e-bc9b68d4fce9",
          "connectionFolderKey": "e716bfc7-4c75-4921-ab5b-e5a3bc0d4c2c",
          "method": "POST",
          "endpoint": "/hubs/productivity/send-mail-v2",
          "queryParameters": {
