{
  "id": "2af1fdaa-b414-460f-9f42-b099f793059c",
  "version": "1.9",
  "name": "ARCollectionsDisputeResolution",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "triageAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Grounded Dispute Triage",
        "subLabel": "",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "source": "f7d7d1a5-0f16-43f1-b1b8-b70cef70ece9",
        "agentInputVariables": [
          {
            "id": "recordCreated__output",
            "type": "object",
            "binding": "=$vars.recordCreated.output",
            "description": "Data Fabric dispute record from the Record Created event"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "disputeType",
            "type": "string"
          },
          {
            "id": "rationale",
            "type": "string"
          },
          {
            "id": "confidence",
            "type": "number"
          }
        ]
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isSupportedTriage",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Supported and confident?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "expression": "=js:$vars.triageAgent.output.confidence >= 0.75 && [\"po_mismatch\", \"missing_pod\", \"payment_misapplication\"].indexOf($vars.triageAgent.output.disputeType) >= 0",
        "trueLabel": "Supported",
        "falseLabel": "Manual triage"
      }
    },
    {
      "id": "routeByDisputeType",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Dispute Type",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "po-mismatch",
            "label": "PO mismatch",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"po_mismatch\""
          },
          {
            "id": "missing-pod",
            "label": "Missing POD",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"missing_pod\""
          },
          {
            "id": "payment-misapplication",
            "label": "Payment misapplication",
            "expression": "=js:$vars.triageAgent.output.disputeType === \"payment_misapplication\""
          }
        ]
      }
    },
