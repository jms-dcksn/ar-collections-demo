      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Updated record matches this dispute?"
      },
      "inputs": {
        "trueLabel": "Matching record",
        "falseLabel": "Ignore update",
        "expression": "=js:$vars.recordCreated.output.Id === $vars.waitForApprovalUpdate.output.Id"
      }
    },
    {
      "id": "approvalDecisionSupplied1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Approval decision supplied?"
      },
      "inputs": {
        "trueLabel": "Decision supplied",
        "falseLabel": "Keep waiting",
        "expression": "=js:[\"approved\", \"rejected\"].indexOf(($vars.waitForApprovalUpdate.output.approvalDecision || \"\").toLowerCase()) >= 0"
      }
    }
