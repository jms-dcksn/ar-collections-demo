          "connectionResourceId": "c61c5442-c5d6-4cb2-9c02-f4a541f01e4c",
          "connectionFolderKey": "67fc19c3-e3a7-4523-aac0-fa63ea83d261",
          "method": "POST",
          "endpoint": "/hubs/productivity/send-mail-v2",
          "bodyParameters": {
            "message.toRecipients": "=js:($vars.recordCreated.output.recipientEmail)",
            "message.subject": "=js:($vars.normalizeProposal.output.emailSubject)",
            "message.body.content": "=js:($vars.normalizeProposal.output.emailBody)",
            "saveToSentItems": true
          },
          "queryParameters": {
            "saveAsDraft": false,
            "includeMessageDetails": true
          },
          "uiPathActivityTypeId": "c7ce0a96-2091-3d94-b16f-706ebb1eb351",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"send-mail-v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send-mail-v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/hubs/productivity/send-mail-v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
