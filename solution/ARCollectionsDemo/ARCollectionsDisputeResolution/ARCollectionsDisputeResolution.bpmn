    <bpmn:scriptTask id="normalizeProposal" name="Normalize Proposal" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="normalizeProposal.output" type="any" source="=result.response" var="normalizeProposal.output" />
          <uipath:output name="normalizeProposal.error" type="object" source="=Error" var="normalizeProposal.error" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>edge_poMismatchAgent_normalizeProposal</bpmn:incoming>
      <bpmn:incoming>edge_missingPodAgent_normalizeProposal</bpmn:incoming>
      <bpmn:incoming>edge_paymentMisapplicationAgent_normalizeProposal</bpmn:incoming>
      <bpmn:outgoing>edge_normalizeProposal_persistAwaitingApproval</bpmn:outgoing>
      <bpmn:script><![CDATA[const candidates = [
  vars.poMismatchAgent.output,
  vars.missingPodAgent.output,
  vars.paymentMisapplicationAgent.output
].filter(function (candidate) { return candidate && candidate.caseId; });
if (candidates.length !== 1) {
  throw new Error("Expected exactly one specialist proposal; received " + candidates.length);
}
const proposal = candidates[0];
const required = [
  "caseId", "disputeType", "evidenceSummary", "rootCause",
  "recommendedAction", "actionCode", "adjustmentAmount", "confidence",
  "approvalSummary", "emailSubject", "emailBody", "resourcesUsed"
];
const actual = Object.keys(proposal).sort();
const expected = required.slice().sort();
if (JSON.stringify(actual) !== JSON.stringify(expected)) {
  throw new Error("Specialist proposal must contain exactly the 12-field contract");
}
required.forEach(function (field) {
  if (proposal[field] === null || proposal[field] === undefined) {
    throw new Error("Missing specialist proposal field: " + field);
  }
});
if (typeof proposal.adjustmentAmount !== "number" || typeof proposal.confidence !== "number") {
  throw new Error("Specialist numeric fields have invalid types");
}
return proposal;]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="needsManualTriage" name="Needs Manual Triage">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="status" type="string" source="=js:&#34;needs_manual_triage&#34;" var="status" custom="true" />
          <uipath:output name="resultCaseId" type="string" source="=js:vars.recordCreated.output.caseId" var="resultCaseId" custom="true" />
          <uipath:output name="disputeType" type="string" source="=js:vars.triageAgent.output.disputeType" var="disputeType" custom="true" />
          <uipath:output name="triageRationale" type="string" source="=js:vars.triageAgent.output.rationale" var="triageRationale" custom="true" />
