            <uipath:input name="entryPoint" type="string" value="1c6b5289-1ff4-45f1-b48c-e613f8fd917f/agent.json" />
            <uipath:input name="inlineAgentMode" type="string" value="detached" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"recordCreated__output":{"type":"object"},"triageAgent__output__disputeType":{"type":"string"},"triageAgent__output__rationale":{"type":"string"},"triageAgent__output__confidence":{"type":"number"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"recordCreated__output":"=js:vars.recordCreated.output","triageAgent__output__disputeType":"=js:vars.triageAgent.output.disputeType","triageAgent__output__rationale":"=js:vars.triageAgent.output.rationale","triageAgent__output__confidence":"=js:vars.triageAgent.output.confidence"}]]></uipath:input>
