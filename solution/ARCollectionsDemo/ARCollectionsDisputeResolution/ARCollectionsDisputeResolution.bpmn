    <bpmn:sequenceFlow id="edge_triageAgent_persistTriaging" sourceRef="triageAgent" targetRef="persistTriaging1" />
    <bpmn:sequenceFlow id="edge_persistTriaging_isSupportedTriage" sourceRef="persistTriaging1" targetRef="isSupportedTriage" />
    <bpmn:sequenceFlow id="edge_isSupportedTriage_supported_routeByDisputeType" name="Supported" sourceRef="isSupportedTriage" targetRef="routeByDisputeType">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.triageAgent.output.confidence &gt;= 0.75 &amp;&amp; ["po_mismatch", "missing_pod", "payment_misapplication"].indexOf(vars.triageAgent.output.disputeType) &gt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_isSupportedTriage_manual_persistNeedsManualTriage" name="Manual triage" sourceRef="isSupportedTriage" targetRef="persistNeedsManualTriage1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:!(vars.triageAgent.output.confidence &gt;= 0.75 &amp;&amp; ["po_mismatch", "missing_pod", "payment_misapplication"].indexOf(vars.triageAgent.output.disputeType) &gt;= 0
)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_route_po_poMismatchAgent" name="PO mismatch" sourceRef="routeByDisputeType" targetRef="poMismatchAgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.triageAgent.output.disputeType === "po_mismatch"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_route_pod_missingPodAgent" name="Missing POD" sourceRef="routeByDisputeType" targetRef="missingPodAgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.triageAgent.output.disputeType === "missing_pod"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_route_payment_paymentMisapplicationAgent" name="Payment misapplication" sourceRef="routeByDisputeType" targetRef="paymentMisapplicationAgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.triageAgent.output.disputeType === "payment_misapplication"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_poMismatchAgent_normalizeProposal" sourceRef="poMismatchAgent" targetRef="normalizeProposal" />
    <bpmn:sequenceFlow id="edge_missingPodAgent_normalizeProposal" sourceRef="missingPodAgent" targetRef="normalizeProposal" />
    <bpmn:sequenceFlow id="edge_paymentMisapplicationAgent_normalizeProposal" sourceRef="paymentMisapplicationAgent" targetRef="normalizeProposal" />
    <bpmn:sequenceFlow id="edge_normalizeProposal_persistAwaitingApproval" sourceRef="normalizeProposal" targetRef="persistAwaitingApproval1" />
    <bpmn:sequenceFlow id="edge_persistAwaitingApproval_waitForApprovalUpdate" sourceRef="persistAwaitingApproval1" targetRef="waitForApprovalUpdate" />
    <bpmn:sequenceFlow id="edge_approvalDecisionSupplied_missing_waitForApprovalUpdate" name="Keep waiting" sourceRef="approvalDecisionSupplied1" targetRef="waitForApprovalUpdate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:!(["approved", "rejected"].indexOf((vars.waitForApprovalUpdate.output.approvalDecision || "").toLowerCase()) &gt;= 0
)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_approvalDecisionSupplied_present_isResolutionApproved" name="Decision supplied" sourceRef="approvalDecisionSupplied1" targetRef="isResolutionApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:["approved", "rejected"].indexOf((vars.waitForApprovalUpdate.output.approvalDecision || "").toLowerCase()) &gt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_isResolutionApproved_persistRejected" name="Needs rework" sourceRef="isResolutionApproved" targetRef="persistRejected1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:!((vars.waitForApprovalUpdate.output.approvalDecision || "").toLowerCase() === "approved"
)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_persistRejected_needsRework" sourceRef="persistRejected1" targetRef="needsRework" />
    <bpmn:sequenceFlow id="edge_isResolutionApproved_persistApproved" name="Approved" sourceRef="isResolutionApproved" targetRef="persistApproved1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.waitForApprovalUpdate.output.approvalDecision || "").toLowerCase() === "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="edge_persistApproved_persistUpdating" sourceRef="persistApproved1" targetRef="persistUpdating1" />
