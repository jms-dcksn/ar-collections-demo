{
  "document": {
    "dsl": "1.0.0",
    "name": "Workflow",
    "tags": {
      "projectId": "2ef7af88-fc77-4555-9e2c-b60462c352fe"
    },
    "version": "0.0.1",
    "namespace": "default",
    "metadata": {
      "variables": []
    }
  },
  "input": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "customerAccountId": {
            "type": "string"
          },
          "invoiceNumber": {
            "type": "string"
          },
          "paymentReference": {
            "type": "string"
          }
        },
        "required": [
          "caseId",
          "customerAccountId",
          "invoiceNumber",
          "paymentReference"
        ],
        "title": "Inputs"
      }
    }
  },
  "output": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "paymentReference": {
            "type": "string"
          },
          "paymentAmount": {
            "type": "number"
          },
          "paymentDate": {
            "type": "string"
          },
          "appliedInvoiceNumber": {
            "type": "string"
          },
          "targetInvoiceNumber": {
            "type": "string"
          },
          "applicationStatus": {
            "type": "string"
          },
          "matchedRemittance": {
            "type": "boolean"
          },
          "recommendedAction": {
            "type": "string"
          },
          "sourceSystem": {
            "type": "string"
          }
        },
        "required": [
          "paymentReference",
          "paymentAmount",
          "paymentDate",
          "appliedInvoiceNumber",
          "targetInvoiceNumber",
          "applicationStatus",
          "matchedRemittance",
          "recommendedAction",
          "sourceSystem"
        ],
        "title": "Outputs"
      }
    }
  },
  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}) }",
              "output": {
                "as": "${$input}"
              },
              "export": {
                "as": "{ ...$context, variables: { ...$context.variables, ...$output } }"
              },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Workflow start",
                "fullName": "Assign",
                "isTransparent": true
              }
            }
          },
          {
            "Javascript_1": {
              "run": {
                "script": {
                  "code": "const { caseId, customerAccountId, invoiceNumber, paymentReference } = $workflow.input;\nconst supportedCaseId = caseId === 'AR-PAY-003' || /^AR-PAY-\\d{8}-[A-F0-9]{8}$/.test(caseId);\nconst supportedFixture = customerAccountId === 'SUMMIT-4402'\n  && invoiceNumber === 'INV-30915'\n  && paymentReference === 'PAY-77821';\nif (!supportedCaseId || !supportedFixture) {\n  throw new Error('LookupPaymentApplication supports only the curated payment demo fixture.');\n}\nreturn {\n  paymentReference: 'PAY-77821',\n  paymentAmount: 36800,\n  paymentDate: '2026-07-02',\n  appliedInvoiceNumber: 'INV-30909',\n  targetInvoiceNumber: 'INV-30915',\n  applicationStatus: 'MISAPPLIED',\n  matchedRemittance: true,\n  recommendedAction: 'REALLOCATE_PAYMENT',\n  sourceSystem: 'MockCashApplication'\n};",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_1\": $output } }"
              },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Lookup payment application",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Response_1": {
              "response": "${$context.outputs.Javascript_1}",
              "markJobAsFailed": false,
              "then": "end",
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }"
              },
              "metadata": {
                "activityType": "Response",
                "displayName": "Return payment application",
                "fullName": "Response"
              }
            }
          }
        ],
        "metadata": {
          "activityType": "Sequence",
          "displayName": "Sequence",
          "fullName": "Sequence"
        }
      }
    }
  ],
  "evaluate": {
    "mode": "strict",
    "language": "javascript"
  }
}
